{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/race-command-center",
      "destination": "/split-watch",
      "permanent": true
    },
    {
      "source": "/race-command-center/",
      "destination": "/split-watch/",
      "permanent": true
    },
    {
      "source": "/race-command-center/:path(.*)",
      "destination": "/split-watch/:path",
      "permanent": true
    },
    {
      "source": "/stories/2026-division-1-boys-cross-country-top-25/",
      "destination": "/rankings/cross-country/boys/division-1/2026-division-1-boys-cross-country-top-25/",
      "permanent": true
    },
    {
      "source": "/stories/2026-division-2-boys-cross-country-top-25/",
      "destination": "/rankings/cross-country/boys/division-2/2026-division-2-boys-cross-country-top-25/",
      "permanent": true
    },
    {
      "source": "/stories/2026-division-3-boys-cross-country-top-25/",
      "destination": "/rankings/cross-country/boys/division-3/2026-division-3-boys-cross-country-top-25/",
      "permanent": true
    },
    {
      "source": "/stories/2026-division-4-boys-cross-country-top-25/",
      "destination": "/rankings/cross-country/boys/division-4/2026-division-4-boys-cross-country-top-25/",
      "permanent": true
    },
    {
      "source": "/stories/2026-division-1-girls-cross-country-top-25/",
      "destination": "/rankings/cross-country/girls/division-1/2026-division-1-girls-cross-country-top-25/",
      "permanent": true
    },
    {
      "source": "/stories/2026-division-2-girls-cross-country-top-25/",
      "destination": "/rankings/cross-country/girls/division-2/2026-division-2-girls-cross-country-top-25/",
      "permanent": true
    },
    {
      "source": "/stories/2026-division-3-girls-cross-country-top-25/",
      "destination": "/rankings/cross-country/girls/division-3/2026-division-3-girls-cross-country-top-25/",
      "permanent": true
    },
    {
      "source": "/stories/2026-division-4-girls-cross-country-top-25/",
      "destination": "/rankings/cross-country/girls/division-4/2026-division-4-girls-cross-country-top-25/",
      "permanent": true
    },
    {
      "source": "/commitments/",
      "destination": "/commitments/2027/",
      "permanent": false
    },
    {
      "source": "/athlete/",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[a-z0-9-]+)"
        }
      ],
      "destination": "/athletes/:slug/",
      "permanent": true
    },
    {
      "source": "/ig",
      "destination": "/teams/instagram/",
      "permanent": false
    },
    {
      "source": "/ig/",
      "destination": "/teams/instagram/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/athletes/:slug([a-z0-9-]+)/",
      "destination": "/api/pages/athlete?slug=:slug"
    },
    {
      "source": "/commitments/:class([0-9]{4})/",
      "destination": "/api/pages/commitments?class=:class"
    },
    {
      "source": "/sponsors/",
      "destination": "/api/pages/sponsors"
    },
    {
      "source": "/teams/:slug([a-z0-9-]+)/",
      "destination": "/api/pages/team?slug=:slug"
    },
    {
      "source": "/front-page/",
      "destination": "/api/pages/front-page"
    },
    {
      "source": "/front",
      "destination": "/api/pages/front-page?go=1"
    },
    {
      "source": "/front/",
      "destination": "/api/pages/front-page?go=1"
    },
    {
      "source": "/:stage(state|regionals|districts)/:year([0-9]{4})/",
      "destination": "/api/pages/season-hub?stage=:stage&year=:year"
    },
    {
      "source": "/:stage(state|regionals|districts)/",
      "destination": "/api/pages/season-hub?stage=:stage"
    },
    {
      "source": "/go/:sponsor/:placement/",
      "destination": "/api/go/:sponsor/:placement"
    },
    {
      "source": "/:path([a-z0-9][a-z0-9-]{0,39})/",
      "destination": "/api/s/:path"
    }
  ],
  "functions": {
    "api/og/front-page.js": {
      "includeFiles": "node_modules/@fontsource/{big-shoulders-display,outfit}/files/*-latin-*-normal.woff"
    },
    "api/cron/finish-timing-scan.js": {
      "maxDuration": 300
    },
    "api/og/team.js": {
      "includeFiles": "node_modules/@fontsource/{big-shoulders-display,outfit}/files/*-latin-*-normal.woff"
    }
  },
  "crons": [
    {
      "path": "/api/cron/notifications/",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/weekly-digest/",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/team-instagram-digest/",
      "schedule": "30 13 * * 1"
    },
    {
      "path": "/api/cron/finish-timing-scan/",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/open-scheduled-nominations/",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/close-scheduled-nominations/",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/purge-photo-submissions/",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/health/",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/awards-2026-votes/",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/styles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
